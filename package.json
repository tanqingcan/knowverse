{
  "name": "knowverse",
  "version": "0.1.0",
  "private": true,
  "description": "知屿 KNOWVERSE：星球花园式个人学习智能体（数据库系统概论大作业）",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts && tsx scripts/migrate.ts && tsx scripts/seed.ts",
    "test": "vitest run",
    "explain": "tsx scripts/explain.ts",
    "demo:reset": "tsx scripts/seed.ts",
    "docs:diagrams": "python3 docs/er/gen_er.py && python3 docs/schema/gen_schema.py"
  },
  "dependencies": {
    "@react-three/fiber": "^9.3.0",
    "drizzle-orm": "^0.44.5",
    "jszip": "^3.10.1",
    "next": "^15.5.28",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0",
    "unpdf": "^1.3.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
