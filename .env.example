# ── 数据库（业务权威来源）──
DATABASE_URL=postgres://postgres:postgres@localhost:5432/knowverse
# SQL 练习受限沙箱（独立数据库 + 只读角色，不能访问业务库）
SANDBOX_DATABASE_URL=postgres://kv_sandbox:kv_sandbox_pw@localhost:5432/knowverse_sandbox
# 创建沙箱库/角色时使用的管理员连接（仅 db:migrate 使用；可与 DATABASE_URL 相同）
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# ── 大模型（仅服务端读取，不会下发到浏览器）──
# LLM_MODE=demo  使用固定演示回答（界面明确标注“演示模式”），持久化流程仍真实执行
# LLM_MODE=live  调用 OpenAI 兼容的 Chat Completions 接口；失败时显示错误与重试，不回退为模拟内容
LLM_MODE=demo
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=45000
# 是否允许模型在回答前调用只读工具（需要服务商支持 tools / function calling）
LLM_TOOL_CALLING=true

# 上传文件保存目录
UPLOAD_DIR=./storage/uploads
