digraph G { graph [rankdir=LR, splines=true, nodesep=0.35, ranksep=1.1, fontname="Noto Sans CJK SC", label="关系模式图（一）：P0/P1 核心——由数据库目录自动生成；箭头由被引用表指向引用表（1 → n）；部分指向 users 的外键仅以 FK 标注", labelloc=t, fontsize=22, pad=0.4];
node [fontname="Noto Sans CJK SC", fontsize=11]; edge [color="#5A4D8C", arrowhead=crow, arrowtail=tee, dir=both, penwidth=1.1];
