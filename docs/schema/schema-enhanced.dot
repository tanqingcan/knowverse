digraph G { graph [rankdir=LR, splines=true, nodesep=0.35, ranksep=1.1, fontname="Noto Sans CJK SC", label="关系模式图（二）：增强功能与其引用的核心表", labelloc=t, fontsize=22, pad=0.4];
node [fontname="Noto Sans CJK SC", fontsize=11]; edge [color="#5A4D8C", arrowhead=crow, arrowtail=tee, dir=both, penwidth=1.1];
