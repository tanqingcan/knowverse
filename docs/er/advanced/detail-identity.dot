digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.40", ranksep="0.80", splines=polyline, overlap=false, outputorder=edgesfirst, fontname="Microsoft YaHei", fontsize=23, label="身份与访问  字段级逻辑ER", labelloc=t];
node [fontname="Microsoft YaHei",fontsize=12]; edge [fontname="Microsoft YaHei",fontsize=10,labelfontsize=10,labeldistance=1.6];
"users" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#516a87"><TR><TD COLSPAN="3" BGCOLOR="#516a87"><FONT COLOR="white"><B>用户</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>users</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="last_conversation_id" ALIGN="LEFT">last_conversation_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD>FK</TD><TD PORT="last_plant_id" ALIGN="LEFT">last_plant_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="handle" ALIGN="LEFT">handle</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="display_name" ALIGN="LEFT">display_name</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有7个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ handle</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">2 CHECK</TD></TR></TABLE>>];
"auth_sessions" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#516a87"><TR><TD COLSPAN="3" BGCOLOR="#516a87"><FONT COLOR="white"><B>认证会话</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>auth_sessions</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="user_id" ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD></TD><TD PORT="token_hash" ALIGN="LEFT">token_hash</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有2个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ token_hash</FONT></TD></TR></TABLE>>];
"conversations" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#85909e"><TR><TD COLSPAN="3" BGCOLOR="#85909e"><FONT COLOR="white"><B>问答会话</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>conversations</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="user_id" ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="subject_id" ALIGN="LEFT">subject_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD>FK</TD><TD PORT="goal_id" ALIGN="LEFT">goal_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD>FK</TD><TD PORT="focus_concept_id" ALIGN="LEFT">focus_concept_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="title" ALIGN="LEFT">title</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="origin" ALIGN="LEFT">origin</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有3个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ id,user_id</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">1 触发器 / 1 CHECK</TD></TR></TABLE>>];
"plants" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#85909e"><TR><TD COLSPAN="3" BGCOLOR="#85909e"><FONT COLOR="white"><B>知识植物</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>plants</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="garden_id" ALIGN="LEFT">garden_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="concept_id" ALIGN="LEFT">concept_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD></TD><TD PORT="species" ALIGN="LEFT">species</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="color" ALIGN="LEFT">color</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有5个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ garden_id,concept_id</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">1 CHECK</TD></TR></TABLE>>];
"users" -> "conversations" [dir=none color="#8b98a7" penwidth=1.1 headlabel="0..1" taillabel="0..N" label="" tooltip="FOREIGN KEY (last_conversation_id) REFERENCES conversations(id) ON DELETE SET NULL"];
"users" -> "plants" [dir=none color="#8b98a7" penwidth=1.1 headlabel="0..1" taillabel="0..N" label="" tooltip="FOREIGN KEY (last_plant_id) REFERENCES plants(id) ON DELETE SET NULL"];
"auth_sessions" -> "users" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE"];
"conversations" -> "users" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE"];
}