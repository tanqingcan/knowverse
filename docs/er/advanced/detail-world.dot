digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.40", ranksep="0.80", splines=polyline, overlap=false, outputorder=edgesfirst, fontname="Microsoft YaHei", fontsize=23, label="星球与布局  字段级逻辑ER", labelloc=t];
node [fontname="Microsoft YaHei",fontsize=12]; edge [fontname="Microsoft YaHei",fontsize=10,labelfontsize=10,labeldistance=1.6];
"planets" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#6c8054"><TR><TD COLSPAN="3" BGCOLOR="#6c8054"><FONT COLOR="white"><B>个人星球</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>planets</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="user_id" ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="natal_plant_id" ALIGN="LEFT">natal_plant_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="sky_theme" ALIGN="LEFT">sky_theme</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有1个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ user_id</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">1 触发器</TD></TR></TABLE>>];
"gardens" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#6c8054"><TR><TD COLSPAN="3" BGCOLOR="#6c8054"><FONT COLOR="white"><B>学科花圃</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>gardens</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="planet_id" ALIGN="LEFT">planet_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="subject_id" ALIGN="LEFT">subject_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD></TD><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="sort_order" ALIGN="LEFT">sort_order</TD><TD ALIGN="LEFT">integer !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有2个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ planet_id,subject_id</FONT></TD></TR></TABLE>>];
"plants" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#6c8054"><TR><TD COLSPAN="3" BGCOLOR="#6c8054"><FONT COLOR="white"><B>知识植物</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>plants</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="garden_id" ALIGN="LEFT">garden_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="concept_id" ALIGN="LEFT">concept_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD></TD><TD PORT="species" ALIGN="LEFT">species</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="color" ALIGN="LEFT">color</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有5个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ garden_id,concept_id</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">1 CHECK</TD></TR></TABLE>>];
"garden_knowledge_places" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#6c8054"><TR><TD COLSPAN="3" BGCOLOR="#6c8054"><FONT COLOR="white"><B>知识地点</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>garden_knowledge_places</B></TD></TR><TR><TD>PK FK</TD><TD PORT="user_id" ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>PK FK</TD><TD PORT="concept_id" ALIGN="LEFT">concept_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>PK </TD><TD PORT="place" ALIGN="LEFT">place</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">1 CHECK</TD></TR></TABLE>>];
"planet_layouts" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#6c8054"><TR><TD COLSPAN="3" BGCOLOR="#6c8054"><FONT COLOR="white"><B>布局草稿与发布</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>planet_layouts</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="planet_id" ALIGN="LEFT">planet_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD></TD><TD PORT="revision" ALIGN="LEFT">revision</TD><TD ALIGN="LEFT">integer !</TD></TR><TR><TD></TD><TD PORT="status" ALIGN="LEFT">status</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有8个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ planet_id</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">2 CHECK</TD></TR></TABLE>>];
"planet_layout_items" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#6c8054"><TR><TD COLSPAN="3" BGCOLOR="#6c8054"><FONT COLOR="white"><B>布局实例</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>planet_layout_items</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="layout_id" ALIGN="LEFT">layout_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD></TD><TD PORT="kind" ALIGN="LEFT">kind</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="x" ALIGN="LEFT">x</TD><TD ALIGN="LEFT">real !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有11个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">1 CHECK</TD></TR></TABLE>>];
"concepts" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#85909e"><TR><TD COLSPAN="3" BGCOLOR="#85909e"><FONT COLOR="white"><B>知识点</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>concepts</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="subject_id" ALIGN="LEFT">subject_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="owner_user_id" ALIGN="LEFT">owner_user_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="name_norm" ALIGN="LEFT">name_norm</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有3个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">条件UQ subject_id,owner_user_id,name_norm</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">条件UQ subject_id,name_norm</FONT></TD></TR></TABLE>>];
"subjects" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#85909e"><TR><TD COLSPAN="3" BGCOLOR="#85909e"><FONT COLOR="white"><B>学科</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>subjects</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="owner_user_id" ALIGN="LEFT">owner_user_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="code" ALIGN="LEFT">code</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有2个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">条件UQ owner_user_id,code</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">条件UQ code</FONT></TD></TR></TABLE>>];
"users" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#85909e"><TR><TD COLSPAN="3" BGCOLOR="#85909e"><FONT COLOR="white"><B>用户</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>users</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="last_conversation_id" ALIGN="LEFT">last_conversation_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD>FK</TD><TD PORT="last_plant_id" ALIGN="LEFT">last_plant_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="handle" ALIGN="LEFT">handle</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="display_name" ALIGN="LEFT">display_name</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有7个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ handle</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">2 CHECK</TD></TR></TABLE>>];
"planets" -> "plants" [dir=none color="#8b98a7" penwidth=1.1 headlabel="0..1" taillabel="0..N" label="" tooltip="FOREIGN KEY (natal_plant_id) REFERENCES plants(id) ON DELETE SET NULL DEFERRABLE INITIALLY DEFERRED"];
"planets" -> "users" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..1" label="" tooltip="FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE"];
"gardens" -> "planets" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (planet_id) REFERENCES planets(id) ON DELETE CASCADE"];
"gardens" -> "subjects" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (subject_id) REFERENCES subjects(id) ON DELETE RESTRICT"];
"plants" -> "concepts" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (concept_id) REFERENCES concepts(id) ON DELETE RESTRICT"];
"plants" -> "gardens" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (garden_id) REFERENCES gardens(id) ON DELETE CASCADE"];
"garden_knowledge_places" -> "concepts" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (concept_id) REFERENCES concepts(id) ON DELETE CASCADE"];
"garden_knowledge_places" -> "users" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE"];
"planet_layouts" -> "planets" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..1" label="" tooltip="FOREIGN KEY (planet_id) REFERENCES planets(id) ON DELETE CASCADE"];
"planet_layout_items" -> "planet_layouts" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (layout_id) REFERENCES planet_layouts(id) ON DELETE CASCADE"];
"concepts" -> "users" [dir=none color="#8b98a7" penwidth=1.1 headlabel="0..1" taillabel="0..N" label="" tooltip="FOREIGN KEY (owner_user_id) REFERENCES users(id) ON DELETE RESTRICT"];
"concepts" -> "subjects" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (subject_id) REFERENCES subjects(id) ON DELETE RESTRICT"];
"subjects" -> "users" [dir=none color="#8b98a7" penwidth=1.1 headlabel="0..1" taillabel="0..N" label="" tooltip="FOREIGN KEY (owner_user_id) REFERENCES users(id) ON DELETE RESTRICT"];
"users" -> "plants" [dir=none color="#8b98a7" penwidth=1.1 headlabel="0..1" taillabel="0..N" label="" tooltip="FOREIGN KEY (last_plant_id) REFERENCES plants(id) ON DELETE SET NULL"];
}