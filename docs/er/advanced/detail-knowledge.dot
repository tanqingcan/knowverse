digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.40", ranksep="0.80", splines=polyline, overlap=false, outputorder=edgesfirst, fontname="Microsoft YaHei", fontsize=23, label="知识目录与学习目标  字段级逻辑ER", labelloc=t];
node [fontname="Microsoft YaHei",fontsize=12]; edge [fontname="Microsoft YaHei",fontsize=10,labelfontsize=10,labeldistance=1.6];
"subjects" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#4a7e77"><TR><TD COLSPAN="3" BGCOLOR="#4a7e77"><FONT COLOR="white"><B>学科</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>subjects</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="owner_user_id" ALIGN="LEFT">owner_user_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="code" ALIGN="LEFT">code</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有2个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">条件UQ owner_user_id,code</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">条件UQ code</FONT></TD></TR></TABLE>>];
"concepts" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#4a7e77"><TR><TD COLSPAN="3" BGCOLOR="#4a7e77"><FONT COLOR="white"><B>知识点</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>concepts</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="subject_id" ALIGN="LEFT">subject_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="owner_user_id" ALIGN="LEFT">owner_user_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="name_norm" ALIGN="LEFT">name_norm</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有3个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">条件UQ subject_id,owner_user_id,name_norm</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">条件UQ subject_id,name_norm</FONT></TD></TR></TABLE>>];
"concept_aliases" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#4a7e77"><TR><TD COLSPAN="3" BGCOLOR="#4a7e77"><FONT COLOR="white"><B>概念别名</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>concept_aliases</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="concept_id" ALIGN="LEFT">concept_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="created_by_user_id" ALIGN="LEFT">created_by_user_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="alias" ALIGN="LEFT">alias</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="alias_norm" ALIGN="LEFT">alias_norm</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有1个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ concept_id,alias_norm</FONT></TD></TR></TABLE>>];
"concept_prerequisites" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#4a7e77"><TR><TD COLSPAN="3" BGCOLOR="#4a7e77"><FONT COLOR="white"><B>先修关系</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>concept_prerequisites</B></TD></TR><TR><TD>PK FK</TD><TD PORT="concept_id" ALIGN="LEFT">concept_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>PK FK</TD><TD PORT="prereq_concept_id" ALIGN="LEFT">prereq_concept_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD></TD><TD PORT="created_at" ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">1 触发器 / 1 CHECK</TD></TR></TABLE>>];
"learning_goals" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#4a7e77"><TR><TD COLSPAN="3" BGCOLOR="#4a7e77"><FONT COLOR="white"><B>学习目标</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>learning_goals</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="user_id" ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="subject_id" ALIGN="LEFT">subject_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD></TD><TD PORT="title" ALIGN="LEFT">title</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="description" ALIGN="LEFT">description</TD><TD ALIGN="LEFT">text ?</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有3个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">1 CHECK</TD></TR></TABLE>>];
"goal_concepts" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#4a7e77"><TR><TD COLSPAN="3" BGCOLOR="#4a7e77"><FONT COLOR="white"><B>目标路线</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>goal_concepts</B></TD></TR><TR><TD>PK FK</TD><TD PORT="goal_id" ALIGN="LEFT">goal_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>PK FK</TD><TD PORT="concept_id" ALIGN="LEFT">concept_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD></TD><TD PORT="route_order" ALIGN="LEFT">route_order</TD><TD ALIGN="LEFT">integer !</TD></TR></TABLE>>];
"users" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#85909e"><TR><TD COLSPAN="3" BGCOLOR="#85909e"><FONT COLOR="white"><B>用户</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>users</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="last_conversation_id" ALIGN="LEFT">last_conversation_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD>FK</TD><TD PORT="last_plant_id" ALIGN="LEFT">last_plant_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="handle" ALIGN="LEFT">handle</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="display_name" ALIGN="LEFT">display_name</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有7个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ handle</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">2 CHECK</TD></TR></TABLE>>];
"subjects" -> "users" [dir=none color="#8b98a7" penwidth=1.1 headlabel="0..1" taillabel="0..N" label="" tooltip="FOREIGN KEY (owner_user_id) REFERENCES users(id) ON DELETE RESTRICT"];
"concepts" -> "users" [dir=none color="#8b98a7" penwidth=1.1 headlabel="0..1" taillabel="0..N" label="" tooltip="FOREIGN KEY (owner_user_id) REFERENCES users(id) ON DELETE RESTRICT"];
"concepts" -> "subjects" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (subject_id) REFERENCES subjects(id) ON DELETE RESTRICT"];
"concept_aliases" -> "concepts" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (concept_id) REFERENCES concepts(id) ON DELETE CASCADE"];
"concept_aliases" -> "users" [dir=none color="#8b98a7" penwidth=1.1 headlabel="0..1" taillabel="0..N" label="" tooltip="FOREIGN KEY (created_by_user_id) REFERENCES users(id) ON DELETE SET NULL"];
"concept_prerequisites" -> "concepts" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (concept_id) REFERENCES concepts(id) ON DELETE CASCADE"];
"concept_prerequisites" -> "concepts" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (prereq_concept_id) REFERENCES concepts(id) ON DELETE CASCADE"];
"learning_goals" -> "subjects" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (subject_id) REFERENCES subjects(id) ON DELETE RESTRICT"];
"learning_goals" -> "users" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE"];
"goal_concepts" -> "concepts" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (concept_id) REFERENCES concepts(id) ON DELETE RESTRICT"];
"goal_concepts" -> "learning_goals" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (goal_id) REFERENCES learning_goals(id) ON DELETE CASCADE"];
}