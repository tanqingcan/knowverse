"classes" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#997185"><TR><TD COLSPAN="3" BGCOLOR="#997185"><FONT COLOR="white"><B>班级</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>classes</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="owner_user_id" ALIGN="LEFT">owner_user_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD></TD><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="join_code" ALIGN="LEFT">join_code</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有1个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ join_code</FONT></TD></TR></TABLE>>];
