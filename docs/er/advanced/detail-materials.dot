"material_concepts" -> "material_versions" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (version_id) REFERENCES material_versions(id) ON DELETE CASCADE"];
"material_chunk_concepts" -> "material_chunks" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (chunk_id) REFERENCES material_chunks(id) ON DELETE CASCADE"];
"material_chunk_concepts" -> "concepts" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (concept_id) REFERENCES concepts(id) ON DELETE RESTRICT"];
"material_chunk_embeddings" -> "material_chunks" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (chunk_id) REFERENCES material_chunks(id) ON DELETE CASCADE"];
"message_citations" -> "material_chunks" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (chunk_id) REFERENCES material_chunks(id) ON DELETE RESTRICT"];
"message_citations" -> "messages" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (message_id) REFERENCES messages(id) ON DELETE CASCADE"];
"notes" -> "concepts" [dir=none color="#8b98a7" penwidth=1.1 headlabel="0..1" taillabel="0..N" label="" tooltip="FOREIGN KEY (concept_id) REFERENCES concepts(id) ON DELETE SET NULL"];
"notes" -> "messages" [dir=none color="#8b98a7" penwidth=1.1 headlabel="0..1" taillabel="0..N" label="" tooltip="FOREIGN KEY (source_message_id) REFERENCES messages(id) ON DELETE SET NULL"];
"notes" -> "users" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE"];
"concepts" -> "users" [dir=none color="#8b98a7" penwidth=1.1 headlabel="0..1" taillabel="0..N" label="" tooltip="FOREIGN KEY (owner_user_id) REFERENCES users(id) ON DELETE RESTRICT"];
"concepts" -> "subjects" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (subject_id) REFERENCES subjects(id) ON DELETE RESTRICT"];
"messages" -> "messages" [dir=none color="#8b98a7" penwidth=1.1 headlabel="0..1" taillabel="0..N" label="reply_to_id" tooltip="FOREIGN KEY (reply_to_id) REFERENCES messages(id)"];
"subjects" -> "users" [dir=none color="#8b98a7" penwidth=1.1 headlabel="0..1" taillabel="0..N" label="" tooltip="FOREIGN KEY (owner_user_id) REFERENCES users(id) ON DELETE RESTRICT"];
