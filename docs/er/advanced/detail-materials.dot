digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.40", ranksep="0.80", splines=polyline, overlap=false, outputorder=edgesfirst, fontname="Microsoft YaHei", fontsize=23, label="资料版本 引用与笔记  字段级逻辑ER", labelloc=t];
node [fontname="Microsoft YaHei",fontsize=12]; edge [fontname="Microsoft YaHei",fontsize=10,labelfontsize=10,labeldistance=1.6];
"materials" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#507a9b"><TR><TD COLSPAN="3" BGCOLOR="#507a9b"><FONT COLOR="white"><B>教学资料</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>materials</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="owner_user_id" ALIGN="LEFT">owner_user_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD>FK</TD><TD PORT="subject_id" ALIGN="LEFT">subject_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD></TD><TD PORT="title" ALIGN="LEFT">title</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="course" ALIGN="LEFT">course</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有3个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">1 CHECK</TD></TR></TABLE>>];
"material_versions" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#507a9b"><TR><TD COLSPAN="3" BGCOLOR="#507a9b"><FONT COLOR="white"><B>资料版本</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>material_versions</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="material_id" ALIGN="LEFT">material_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="uploaded_by_user_id" ALIGN="LEFT">uploaded_by_user_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="version_no" ALIGN="LEFT">version_no</TD><TD ALIGN="LEFT">integer !</TD></TR><TR><TD></TD><TD PORT="file_name" ALIGN="LEFT">file_name</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有10个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ material_id,version_no</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">2 CHECK</TD></TR></TABLE>>];
"material_chunks" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#507a9b"><TR><TD COLSPAN="3" BGCOLOR="#507a9b"><FONT COLOR="white"><B>资料片段</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>material_chunks</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="version_id" ALIGN="LEFT">version_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD></TD><TD PORT="ord" ALIGN="LEFT">ord</TD><TD ALIGN="LEFT">integer !</TD></TR><TR><TD></TD><TD PORT="page_no" ALIGN="LEFT">page_no</TD><TD ALIGN="LEFT">integer ?</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有5个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ version_id,ord</FONT></TD></TR></TABLE>>];
"material_concepts" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#507a9b"><TR><TD COLSPAN="3" BGCOLOR="#507a9b"><FONT COLOR="white"><B>版本概念</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>material_concepts</B></TD></TR><TR><TD>PK FK</TD><TD PORT="version_id" ALIGN="LEFT">version_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>PK FK</TD><TD PORT="concept_id" ALIGN="LEFT">concept_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD></TD><TD PORT="status" ALIGN="LEFT">status</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="hit_count" ALIGN="LEFT">hit_count</TD><TD ALIGN="LEFT">integer !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">1 CHECK</TD></TR></TABLE>>];
"material_chunk_concepts" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#507a9b"><TR><TD COLSPAN="3" BGCOLOR="#507a9b"><FONT COLOR="white"><B>片段知识点</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>material_chunk_concepts</B></TD></TR><TR><TD>PK FK</TD><TD PORT="chunk_id" ALIGN="LEFT">chunk_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>PK FK</TD><TD PORT="concept_id" ALIGN="LEFT">concept_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD></TD><TD PORT="source" ALIGN="LEFT">source</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="matched_term" ALIGN="LEFT">matched_term</TD><TD ALIGN="LEFT">text ?</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有2个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">2 CHECK</TD></TR></TABLE>>];
"material_chunk_embeddings" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#507a9b"><TR><TD COLSPAN="3" BGCOLOR="#507a9b"><FONT COLOR="white"><B>片段向量</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>material_chunk_embeddings</B></TD></TR><TR><TD>PK FK</TD><TD PORT="chunk_id" ALIGN="LEFT">chunk_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>PK </TD><TD PORT="model_key" ALIGN="LEFT">model_key</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="embedding" ALIGN="LEFT">embedding</TD><TD ALIGN="LEFT">real[] !</TD></TR><TR><TD></TD><TD PORT="indexed_at" ALIGN="LEFT">indexed_at</TD><TD ALIGN="LEFT">timestamptz !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">2 CHECK</TD></TR></TABLE>>];
"message_citations" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#507a9b"><TR><TD COLSPAN="3" BGCOLOR="#507a9b"><FONT COLOR="white"><B>消息引用</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>message_citations</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="message_id" ALIGN="LEFT">message_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="chunk_id" ALIGN="LEFT">chunk_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD></TD><TD PORT="ref_label" ALIGN="LEFT">ref_label</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="quote" ALIGN="LEFT">quote</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有1个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ message_id,chunk_id</FONT></TD></TR></TABLE>>];
"notes" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#507a9b"><TR><TD COLSPAN="3" BGCOLOR="#507a9b"><FONT COLOR="white"><B>学习笔记</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>notes</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="user_id" ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="concept_id" ALIGN="LEFT">concept_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD>FK</TD><TD PORT="source_message_id" ALIGN="LEFT">source_message_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="title" ALIGN="LEFT">title</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="content" ALIGN="LEFT">content</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有3个属性 见目录快照</FONT></TD></TR></TABLE>>];
"concepts" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#85909e"><TR><TD COLSPAN="3" BGCOLOR="#85909e"><FONT COLOR="white"><B>知识点</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>concepts</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="subject_id" ALIGN="LEFT">subject_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="owner_user_id" ALIGN="LEFT">owner_user_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="name_norm" ALIGN="LEFT">name_norm</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有3个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">条件UQ subject_id,owner_user_id,name_norm</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">条件UQ subject_id,name_norm</FONT></TD></TR></TABLE>>];
"messages" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#85909e"><TR><TD COLSPAN="3" BGCOLOR="#85909e"><FONT COLOR="white"><B>消息</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>messages</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="conversation_id" ALIGN="LEFT">conversation_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="user_id" ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="reply_to_id" ALIGN="LEFT">reply_to_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD>FK</TD><TD PORT="model_call_id" ALIGN="LEFT">model_call_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="seq" ALIGN="LEFT">seq</TD><TD ALIGN="LEFT">integer !</TD></TR><TR><TD></TD><TD PORT="role" ALIGN="LEFT">role</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有7个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ conversation_id,seq</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">1 触发器 / 5 CHECK</TD></TR></TABLE>>];
"subjects" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#85909e"><TR><TD COLSPAN="3" BGCOLOR="#85909e"><FONT COLOR="white"><B>学科</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>subjects</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="owner_user_id" ALIGN="LEFT">owner_user_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="code" ALIGN="LEFT">code</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有2个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">条件UQ owner_user_id,code</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">条件UQ code</FONT></TD></TR></TABLE>>];
"users" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#85909e"><TR><TD COLSPAN="3" BGCOLOR="#85909e"><FONT COLOR="white"><B>用户</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>users</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="last_conversation_id" ALIGN="LEFT">last_conversation_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD>FK</TD><TD PORT="last_plant_id" ALIGN="LEFT">last_plant_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="handle" ALIGN="LEFT">handle</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="display_name" ALIGN="LEFT">display_name</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有7个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ handle</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">2 CHECK</TD></TR></TABLE>>];
"materials" -> "users" [dir=none color="#8b98a7" penwidth=1.1 headlabel="0..1" taillabel="0..N" label="" tooltip="FOREIGN KEY (owner_user_id) REFERENCES users(id) ON DELETE RESTRICT"];
"materials" -> "subjects" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (subject_id) REFERENCES subjects(id) ON DELETE RESTRICT"];
"material_versions" -> "materials" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (material_id) REFERENCES materials(id) ON DELETE RESTRICT"];
"material_versions" -> "users" [dir=none color="#8b98a7" penwidth=1.1 headlabel="0..1" taillabel="0..N" label="" tooltip="FOREIGN KEY (uploaded_by_user_id) REFERENCES users(id) ON DELETE SET NULL"];
"material_chunks" -> "material_versions" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (version_id) REFERENCES material_versions(id) ON DELETE RESTRICT"];
