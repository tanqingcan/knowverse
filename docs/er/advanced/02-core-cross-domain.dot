digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.40", ranksep="0.80", splines=polyline, overlap=false, outputorder=edgesfirst, fontname="Microsoft YaHei", fontsize=23, label="核心跨域关系  版本引用 / 证据成长 / 班级发布", labelloc=t];
node [fontname="Microsoft YaHei",fontsize=12]; edge [fontname="Microsoft YaHei",fontsize=10,labelfontsize=10,labeldistance=1.6];
"conversations" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#6c6692"><TR><TD COLSPAN="3" BGCOLOR="#6c6692"><FONT COLOR="white"><B>问答会话</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>conversations</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">PK id</TD></TR></TABLE>>];
"messages" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#6c6692"><TR><TD COLSPAN="3" BGCOLOR="#6c6692"><FONT COLOR="white"><B>消息</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>messages</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">PK id</TD></TR></TABLE>>];
"message_concepts" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#6c6692"><TR><TD COLSPAN="3" BGCOLOR="#6c6692"><FONT COLOR="white"><B>消息标签</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>message_concepts</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">PK concept_id, message_id</TD></TR></TABLE>>];
"message_terms" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#6c6692"><TR><TD COLSPAN="3" BGCOLOR="#6c6692"><FONT COLOR="white"><B>倒排词项</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>message_terms</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">PK message_id, term</TD></TR></TABLE>>];
"model_calls" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#6c6692"><TR><TD COLSPAN="3" BGCOLOR="#6c6692"><FONT COLOR="white"><B>模型调用</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>model_calls</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">PK id</TD></TR></TABLE>>];
"memories" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#6c6692"><TR><TD COLSPAN="3" BGCOLOR="#6c6692"><FONT COLOR="white"><B>学习记忆</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>memories</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">PK id</TD></TR></TABLE>>];
"conversation_summaries" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#6c6692"><TR><TD COLSPAN="3" BGCOLOR="#6c6692"><FONT COLOR="white"><B>会话摘要</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>conversation_summaries</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">PK conversation_id</TD></TR></TABLE>>];
"materials" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#507a9b"><TR><TD COLSPAN="3" BGCOLOR="#507a9b"><FONT COLOR="white"><B>教学资料</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>materials</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">PK id</TD></TR></TABLE>>];
"material_versions" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#507a9b"><TR><TD COLSPAN="3" BGCOLOR="#507a9b"><FONT COLOR="white"><B>资料版本</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>material_versions</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">PK id</TD></TR></TABLE>>];
"material_chunks" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#507a9b"><TR><TD COLSPAN="3" BGCOLOR="#507a9b"><FONT COLOR="white"><B>资料片段</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>material_chunks</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">PK id</TD></TR></TABLE>>];
"message_citations" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#507a9b"><TR><TD COLSPAN="3" BGCOLOR="#507a9b"><FONT COLOR="white"><B>消息引用</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>message_citations</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">PK id</TD></TR></TABLE>>];
"tasks" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#9b7350"><TR><TD COLSPAN="3" BGCOLOR="#9b7350"><FONT COLOR="white"><B>题目身份</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>tasks</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">PK id</TD></TR></TABLE>>];
"task_versions" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#9b7350"><TR><TD COLSPAN="3" BGCOLOR="#9b7350"><FONT COLOR="white"><B>题目版本</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>task_versions</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">PK id</TD></TR></TABLE>>];
"attempts" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#9b7350"><TR><TD COLSPAN="3" BGCOLOR="#9b7350"><FONT COLOR="white"><B>作答</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>attempts</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">PK id</TD></TR></TABLE>>];
"evaluations" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#9b7350"><TR><TD COLSPAN="3" BGCOLOR="#9b7350"><FONT COLOR="white"><B>评价</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>evaluations</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">PK id</TD></TR></TABLE>>];
"learning_evidence" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#9b7350"><TR><TD COLSPAN="3" BGCOLOR="#9b7350"><FONT COLOR="white"><B>学习证据</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>learning_evidence</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">PK id</TD></TR></TABLE>>];
"learning_states" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#9b7350"><TR><TD COLSPAN="3" BGCOLOR="#9b7350"><FONT COLOR="white"><B>当前学习状态</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>learning_states</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">PK concept_id, user_id</TD></TR></TABLE>>];
"growth_events" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#9b7350"><TR><TD COLSPAN="3" BGCOLOR="#9b7350"><FONT COLOR="white"><B>成长事件</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>growth_events</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">PK id</TD></TR></TABLE>>];
"classes" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#997185"><TR><TD COLSPAN="3" BGCOLOR="#997185"><FONT COLOR="white"><B>班级</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>classes</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">PK id</TD></TR></TABLE>>];
"class_members" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#997185"><TR><TD COLSPAN="3" BGCOLOR="#997185"><FONT COLOR="white"><B>班级成员</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>class_members</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">PK class_id, user_id</TD></TR></TABLE>>];
"sharing_preferences" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#997185"><TR><TD COLSPAN="3" BGCOLOR="#997185"><FONT COLOR="white"><B>分享偏好</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>sharing_preferences</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">PK class_id, user_id</TD></TR></TABLE>>];
"study_groups" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#997185"><TR><TD COLSPAN="3" BGCOLOR="#997185"><FONT COLOR="white"><B>共学小组</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>study_groups</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">PK id</TD></TR></TABLE>>];
