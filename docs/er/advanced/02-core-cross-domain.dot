"card_versions" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#997185"><TR><TD COLSPAN="3" BGCOLOR="#997185"><FONT COLOR="white"><B>卡片版本</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>card_versions</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">PK id</TD></TR></TABLE>>];
"card_publications" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#997185"><TR><TD COLSPAN="3" BGCOLOR="#997185"><FONT COLOR="white"><B>班级发布</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>card_publications</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">PK card_version_id, class_id</TD></TR></TABLE>>];
"messages" -> "conversations" [dir=none color="#77519c" penwidth=2 headlabel="1" taillabel="0..N" label="复合归属FK" tooltip="FOREIGN KEY (conversation_id, user_id) REFERENCES conversations(id, user_id) ON DELETE CASCADE"];
"messages" -> "model_calls" [dir=none color="#8b98a7" penwidth=1.1 headlabel="0..1" taillabel="0..N" label="" tooltip="FOREIGN KEY (model_call_id) REFERENCES model_calls(id) ON DELETE SET NULL"];
"messages" -> "messages" [dir=none color="#8b98a7" penwidth=1.1 headlabel="0..1" taillabel="0..N" label="reply_to_id" tooltip="FOREIGN KEY (reply_to_id) REFERENCES messages(id)"];
