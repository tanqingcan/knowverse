"contributions" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#997185"><TR><TD COLSPAN="3" BGCOLOR="#997185"><FONT COLOR="white"><B>贡献</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>contributions</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">PK id</TD></TR></TABLE>>];
