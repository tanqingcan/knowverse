digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.40", ranksep="0.80", splines=polyline, overlap=false, outputorder=edgesfirst, fontname="Microsoft YaHei", fontsize=23, label="问答 检索与记忆  字段级逻辑ER", labelloc=t];
node [fontname="Microsoft YaHei",fontsize=12]; edge [fontname="Microsoft YaHei",fontsize=10,labelfontsize=10,labeldistance=1.6];
"conversations" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#6c6692"><TR><TD COLSPAN="3" BGCOLOR="#6c6692"><FONT COLOR="white"><B>问答会话</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>conversations</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="user_id" ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="subject_id" ALIGN="LEFT">subject_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD>FK</TD><TD PORT="goal_id" ALIGN="LEFT">goal_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD>FK</TD><TD PORT="focus_concept_id" ALIGN="LEFT">focus_concept_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="title" ALIGN="LEFT">title</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="origin" ALIGN="LEFT">origin</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有3个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ id,user_id</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">1 触发器 / 1 CHECK</TD></TR></TABLE>>];
"messages" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#6c6692"><TR><TD COLSPAN="3" BGCOLOR="#6c6692"><FONT COLOR="white"><B>消息</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>messages</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="conversation_id" ALIGN="LEFT">conversation_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="user_id" ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="reply_to_id" ALIGN="LEFT">reply_to_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD>FK</TD><TD PORT="model_call_id" ALIGN="LEFT">model_call_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="seq" ALIGN="LEFT">seq</TD><TD ALIGN="LEFT">integer !</TD></TR><TR><TD></TD><TD PORT="role" ALIGN="LEFT">role</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有7个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ conversation_id,seq</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">1 触发器 / 5 CHECK</TD></TR></TABLE>>];
"message_concepts" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#6c6692"><TR><TD COLSPAN="3" BGCOLOR="#6c6692"><FONT COLOR="white"><B>消息标签</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>message_concepts</B></TD></TR><TR><TD>PK FK</TD><TD PORT="message_id" ALIGN="LEFT">message_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>PK FK</TD><TD PORT="concept_id" ALIGN="LEFT">concept_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD></TD><TD PORT="source" ALIGN="LEFT">source</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="status" ALIGN="LEFT">status</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有3个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">2 CHECK</TD></TR></TABLE>>];
"message_terms" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#6c6692"><TR><TD COLSPAN="3" BGCOLOR="#6c6692"><FONT COLOR="white"><B>倒排词项</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>message_terms</B></TD></TR><TR><TD>PK </TD><TD PORT="term" ALIGN="LEFT">term</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD>PK FK</TD><TD PORT="message_id" ALIGN="LEFT">message_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD></TD><TD PORT="weight" ALIGN="LEFT">weight</TD><TD ALIGN="LEFT">real !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">1 CHECK</TD></TR></TABLE>>];
"model_calls" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#6c6692"><TR><TD COLSPAN="3" BGCOLOR="#6c6692"><FONT COLOR="white"><B>模型调用</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>model_calls</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="user_id" ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD></TD><TD PORT="purpose" ALIGN="LEFT">purpose</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="mode" ALIGN="LEFT">mode</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有11个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">2 CHECK</TD></TR></TABLE>>];
"concept_suggestions" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#6c6692"><TR><TD COLSPAN="3" BGCOLOR="#6c6692"><FONT COLOR="white"><B>概念建议</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>concept_suggestions</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="user_id" ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="message_id" ALIGN="LEFT">message_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="subject_id" ALIGN="LEFT">subject_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD>FK</TD><TD PORT="accepted_concept_id" ALIGN="LEFT">accepted_concept_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="raw_name" ALIGN="LEFT">raw_name</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="name_norm" ALIGN="LEFT">name_norm</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有2个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ message_id,name_norm</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">1 CHECK</TD></TR></TABLE>>];
"memories" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#6c6692"><TR><TD COLSPAN="3" BGCOLOR="#6c6692"><FONT COLOR="white"><B>学习记忆</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>memories</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="user_id" ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="concept_id" ALIGN="LEFT">concept_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD>FK</TD><TD PORT="source_message_id" ALIGN="LEFT">source_message_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD>FK</TD><TD PORT="source_conversation_id" ALIGN="LEFT">source_conversation_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD>FK</TD><TD PORT="corrects_id" ALIGN="LEFT">corrects_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="kind" ALIGN="LEFT">kind</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="content" ALIGN="LEFT">content</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有9个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">条件UQ user_id,kind,content_norm</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">4 CHECK</TD></TR></TABLE>>];
