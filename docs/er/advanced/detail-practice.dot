digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.40", ranksep="0.80", splines=polyline, overlap=false, outputorder=edgesfirst, fontname="Microsoft YaHei", fontsize=23, label="题目 作答与成长证据  字段级逻辑ER", labelloc=t];
node [fontname="Microsoft YaHei",fontsize=12]; edge [fontname="Microsoft YaHei",fontsize=10,labelfontsize=10,labeldistance=1.6];
"tasks" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#9b7350"><TR><TD COLSPAN="3" BGCOLOR="#9b7350"><FONT COLOR="white"><B>题目身份</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>tasks</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="subject_id" ALIGN="LEFT">subject_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="owner_user_id" ALIGN="LEFT">owner_user_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="kind" ALIGN="LEFT">kind</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="title" ALIGN="LEFT">title</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有3个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">1 CHECK</TD></TR></TABLE>>];
"task_concepts" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#9b7350"><TR><TD COLSPAN="3" BGCOLOR="#9b7350"><FONT COLOR="white"><B>考查知识点</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>task_concepts</B></TD></TR><TR><TD>PK FK</TD><TD PORT="task_id" ALIGN="LEFT">task_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>PK FK</TD><TD PORT="concept_id" ALIGN="LEFT">concept_id</TD><TD ALIGN="LEFT">uuid !</TD></TR></TABLE>>];
"task_versions" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#9b7350"><TR><TD COLSPAN="3" BGCOLOR="#9b7350"><FONT COLOR="white"><B>题目版本</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>task_versions</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="task_id" ALIGN="LEFT">task_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="source_chunk_id" ALIGN="LEFT">source_chunk_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD>FK</TD><TD PORT="model_call_id" ALIGN="LEFT">model_call_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="version_no" ALIGN="LEFT">version_no</TD><TD ALIGN="LEFT">integer !</TD></TR><TR><TD></TD><TD PORT="prompt" ALIGN="LEFT">prompt</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有6个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ task_id,version_no</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">2 CHECK</TD></TR></TABLE>>];
"task_hints" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#9b7350"><TR><TD COLSPAN="3" BGCOLOR="#9b7350"><FONT COLOR="white"><B>版本提示</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>task_hints</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="task_version_id" ALIGN="LEFT">task_version_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD></TD><TD PORT="ord" ALIGN="LEFT">ord</TD><TD ALIGN="LEFT">integer !</TD></TR><TR><TD></TD><TD PORT="content" ALIGN="LEFT">content</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ task_version_id,ord</FONT></TD></TR></TABLE>>];
"attempts" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#9b7350"><TR><TD COLSPAN="3" BGCOLOR="#9b7350"><FONT COLOR="white"><B>作答</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>attempts</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="user_id" ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="task_version_id" ALIGN="LEFT">task_version_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="conversation_id" ALIGN="LEFT">conversation_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="mode" ALIGN="LEFT">mode</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="answer" ALIGN="LEFT">answer</TD><TD ALIGN="LEFT">text ?</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有4个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ user_id,submit_key</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">2 CHECK</TD></TR></TABLE>>];
"hint_events" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#9b7350"><TR><TD COLSPAN="3" BGCOLOR="#9b7350"><FONT COLOR="white"><B>提示查看</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>hint_events</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="attempt_id" ALIGN="LEFT">attempt_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="hint_id" ALIGN="LEFT">hint_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD></TD><TD PORT="shown_at" ALIGN="LEFT">shown_at</TD><TD ALIGN="LEFT">timestamptz !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ attempt_id,hint_id</FONT></TD></TR></TABLE>>];
"evaluations" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#9b7350"><TR><TD COLSPAN="3" BGCOLOR="#9b7350"><FONT COLOR="white"><B>评价</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>evaluations</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="attempt_id" ALIGN="LEFT">attempt_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="model_call_id" ALIGN="LEFT">model_call_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="evaluator" ALIGN="LEFT">evaluator</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="verdict" ALIGN="LEFT">verdict</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有5个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ attempt_id</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">1 CHECK</TD></TR></TABLE>>];
"learning_evidence" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#9b7350"><TR><TD COLSPAN="3" BGCOLOR="#9b7350"><FONT COLOR="white"><B>学习证据</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>learning_evidence</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="user_id" ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="concept_id" ALIGN="LEFT">concept_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="attempt_id" ALIGN="LEFT">attempt_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD>FK</TD><TD PORT="message_id" ALIGN="LEFT">message_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD>FK</TD><TD PORT="note_id" ALIGN="LEFT">note_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD>FK</TD><TD PORT="material_version_id" ALIGN="LEFT">material_version_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="kind" ALIGN="LEFT">kind</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="used_hints" ALIGN="LEFT">used_hints</TD><TD ALIGN="LEFT">boolean !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有6个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">条件UQ attempt_id,concept_id,kind</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">1 触发器 / 2 CHECK</TD></TR></TABLE>>];
"learning_states" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#9b7350"><TR><TD COLSPAN="3" BGCOLOR="#9b7350"><FONT COLOR="white"><B>当前学习状态</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>learning_states</B></TD></TR><TR><TD>PK FK</TD><TD PORT="user_id" ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>PK FK</TD><TD PORT="concept_id" ALIGN="LEFT">concept_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD></TD><TD PORT="stage" ALIGN="LEFT">stage</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="stage_reason" ALIGN="LEFT">stage_reason</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有4个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">1 触发器 / 1 CHECK</TD></TR></TABLE>>];
"growth_events" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#9b7350"><TR><TD COLSPAN="3" BGCOLOR="#9b7350"><FONT COLOR="white"><B>成长事件</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>growth_events</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="user_id" ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="concept_id" ALIGN="LEFT">concept_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="evidence_id" ALIGN="LEFT">evidence_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="event_type" ALIGN="LEFT">event_type</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="from_stage" ALIGN="LEFT">from_stage</TD><TD ALIGN="LEFT">text ?</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有4个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">1 CHECK</TD></TR></TABLE>>];
"concepts" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#85909e"><TR><TD COLSPAN="3" BGCOLOR="#85909e"><FONT COLOR="white"><B>知识点</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>concepts</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="subject_id" ALIGN="LEFT">subject_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="owner_user_id" ALIGN="LEFT">owner_user_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="name_norm" ALIGN="LEFT">name_norm</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有3个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">条件UQ subject_id,owner_user_id,name_norm</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">条件UQ subject_id,name_norm</FONT></TD></TR></TABLE>>];
"conversations" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#85909e"><TR><TD COLSPAN="3" BGCOLOR="#85909e"><FONT COLOR="white"><B>问答会话</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>conversations</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="user_id" ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="subject_id" ALIGN="LEFT">subject_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD>FK</TD><TD PORT="goal_id" ALIGN="LEFT">goal_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD>FK</TD><TD PORT="focus_concept_id" ALIGN="LEFT">focus_concept_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="title" ALIGN="LEFT">title</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="origin" ALIGN="LEFT">origin</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有3个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ id,user_id</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">1 触发器 / 1 CHECK</TD></TR></TABLE>>];
"material_chunks" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#85909e"><TR><TD COLSPAN="3" BGCOLOR="#85909e"><FONT COLOR="white"><B>资料片段</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>material_chunks</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="version_id" ALIGN="LEFT">version_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD></TD><TD PORT="ord" ALIGN="LEFT">ord</TD><TD ALIGN="LEFT">integer !</TD></TR><TR><TD></TD><TD PORT="page_no" ALIGN="LEFT">page_no</TD><TD ALIGN="LEFT">integer ?</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有5个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ version_id,ord</FONT></TD></TR></TABLE>>];
"material_versions" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#85909e"><TR><TD COLSPAN="3" BGCOLOR="#85909e"><FONT COLOR="white"><B>资料版本</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>material_versions</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="material_id" ALIGN="LEFT">material_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="uploaded_by_user_id" ALIGN="LEFT">uploaded_by_user_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="version_no" ALIGN="LEFT">version_no</TD><TD ALIGN="LEFT">integer !</TD></TR><TR><TD></TD><TD PORT="file_name" ALIGN="LEFT">file_name</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有10个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ material_id,version_no</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">2 CHECK</TD></TR></TABLE>>];
"messages" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#85909e"><TR><TD COLSPAN="3" BGCOLOR="#85909e"><FONT COLOR="white"><B>消息</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>messages</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="conversation_id" ALIGN="LEFT">conversation_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="user_id" ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="reply_to_id" ALIGN="LEFT">reply_to_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD>FK</TD><TD PORT="model_call_id" ALIGN="LEFT">model_call_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="seq" ALIGN="LEFT">seq</TD><TD ALIGN="LEFT">integer !</TD></TR><TR><TD></TD><TD PORT="role" ALIGN="LEFT">role</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有7个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ conversation_id,seq</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">1 触发器 / 5 CHECK</TD></TR></TABLE>>];
"model_calls" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#85909e"><TR><TD COLSPAN="3" BGCOLOR="#85909e"><FONT COLOR="white"><B>模型调用</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>model_calls</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="user_id" ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD></TD><TD PORT="purpose" ALIGN="LEFT">purpose</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="mode" ALIGN="LEFT">mode</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有11个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">2 CHECK</TD></TR></TABLE>>];
"notes" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#85909e"><TR><TD COLSPAN="3" BGCOLOR="#85909e"><FONT COLOR="white"><B>学习笔记</B>  · RLS</FONT></TD></TR><TR><TD COLSPAN="3"><B>notes</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="user_id" ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="concept_id" ALIGN="LEFT">concept_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD>FK</TD><TD PORT="source_message_id" ALIGN="LEFT">source_message_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="title" ALIGN="LEFT">title</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="content" ALIGN="LEFT">content</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有3个属性 见目录快照</FONT></TD></TR></TABLE>>];
"subjects" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#85909e"><TR><TD COLSPAN="3" BGCOLOR="#85909e"><FONT COLOR="white"><B>学科</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>subjects</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="owner_user_id" ALIGN="LEFT">owner_user_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="code" ALIGN="LEFT">code</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="name" ALIGN="LEFT">name</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有2个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">条件UQ owner_user_id,code</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">条件UQ code</FONT></TD></TR></TABLE>>];
"users" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white" COLOR="#85909e"><TR><TD COLSPAN="3" BGCOLOR="#85909e"><FONT COLOR="white"><B>用户</B> </FONT></TD></TR><TR><TD COLSPAN="3"><B>users</B></TD></TR><TR><TD>PK </TD><TD PORT="id" ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid !</TD></TR><TR><TD>FK</TD><TD PORT="last_conversation_id" ALIGN="LEFT">last_conversation_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD>FK</TD><TD PORT="last_plant_id" ALIGN="LEFT">last_plant_id</TD><TD ALIGN="LEFT">uuid ?</TD></TR><TR><TD></TD><TD PORT="handle" ALIGN="LEFT">handle</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD></TD><TD PORT="display_name" ALIGN="LEFT">display_name</TD><TD ALIGN="LEFT">text !</TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT COLOR="#697787">另有7个属性 见目录快照</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><FONT POINT-SIZE="10">UQ handle</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT">2 CHECK</TD></TR></TABLE>>];
"tasks" -> "users" [dir=none color="#8b98a7" penwidth=1.1 headlabel="0..1" taillabel="0..N" label="" tooltip="FOREIGN KEY (owner_user_id) REFERENCES users(id) ON DELETE RESTRICT"];
"tasks" -> "subjects" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (subject_id) REFERENCES subjects(id) ON DELETE RESTRICT"];
"task_concepts" -> "concepts" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (concept_id) REFERENCES concepts(id) ON DELETE RESTRICT"];
"task_concepts" -> "tasks" [dir=none color="#8b98a7" penwidth=1.1 headlabel="1" taillabel="0..N" label="" tooltip="FOREIGN KEY (task_id) REFERENCES tasks(id) ON DELETE CASCADE"];
